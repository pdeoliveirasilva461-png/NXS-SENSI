:root{--bg:#080D17;--blue:#2388FF;--blue2:#1265D8;--fg:#FFFFFF;--mut:#9AABC3;--card:#0f1726;--line:#1b2a44;color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--fg);font-family:"Segoe UI",system-ui,-apple-system,Roboto,sans-serif;line-height:1.5}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:10}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:rgba(8,13,23,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.bar{max-width:880px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:8px;padding:10px 16px}
.logo{font-weight:800;letter-spacing:.04em;font-size:15px}.logo b{color:var(--blue)}
nav{display:flex;gap:2px;overflow-x:auto}
nav a{color:var(--mut);text-decoration:none;font-size:13px;padding:8px 10px;border-radius:10px;white-space:nowrap}
nav a.on,nav a:hover{color:#fff;background:var(--card)}
main{max-width:880px;margin:auto;padding:24px 16px 48px}
h1{font-size:clamp(34px,9vw,60px);line-height:1.02;margin:12px 0;font-weight:900;letter-spacing:-.02em}
h2{font-size:22px;margin:28px 0 10px}
p{color:var(--mut);margin:8px 0}
.hero{padding:28px 0 12px;border-bottom:1px solid var(--line)}
.hero h1 span{color:var(--blue)}
.btn{display:inline-block;border:0;cursor:pointer;font:inherit;font-weight:700;color:#fff;background:linear-gradient(135deg,var(--blue),var(--blue2));padding:14px 22px;border-radius:14px;text-decoration:none;box-shadow:0 0 24px rgba(35,136,255,.25)}
.btn.ghost{background:var(--card);border:1px solid var(--line);box-shadow:none}
.btn:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,.opt:focus-visible{outline:2px solid var(--blue);outline-offset:2px}
.row{display:flex;flex-wrap:wrap;gap:10px;margin-top:16px}
.card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:16px}
.grid{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}
label{display:block;font-size:13px;color:var(--mut);margin:14px 0 6px}
input,select{width:100%;background:var(--bg);color:#fff;border:1px solid var(--line);border-radius:12px;padding:13px;font:inherit}
.opts{display:grid;gap:10px}
.opt{background:var(--bg);border:1px solid var(--line);border-radius:14px;padding:13px;cursor:pointer;color:#fff;text-align:left;font:inherit}
.opt small{display:block;color:var(--mut);margin-top:2px}
.opt.sel{border-color:var(--blue);box-shadow:0 0 0 1px var(--blue) inset;background:#0b1a33}
.steps{display:flex;gap:6px;margin-bottom:6px}.steps i{flex:1;height:4px;border-radius:4px;background:var(--line)}.steps i.on{background:var(--blue)}
.err{color:#ff8a8a;font-size:13px;min-height:18px;margin-top:10px}
.sens{margin:12px 0}.sens .t{display:flex;justify-content:space-between;font-weight:700}.sens .t span:last-child{color:var(--blue);font-size:20px}
.track{height:8px;background:var(--line);border-radius:8px;overflow:hidden;margin-top:6px}
.track div{height:100%;background:linear-gradient(90deg,var(--blue2),var(--blue));border-radius:8px;transition:width .6s}
.meta{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:8px;font-size:13px}
.meta b{display:block;color:#fff;font-size:14px}
.note{border-left:3px solid var(--blue);padding:8px 12px;background:#0b1a33;border-radius:8px;font-size:13px;color:var(--mut);margin-top:14px}
.load{text-align:center;padding:60px 0;font-weight:600}
.load::after{content:"";display:block;width:36px;height:36px;margin:18px auto 0;border:3px solid var(--line);border-top-color:var(--blue);border-radius:50%;animation:s 0.9s linear infinite}
@keyframes s{to{transform:rotate(360deg)}}
.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--blue2);padding:10px 18px;border-radius:12px;font-size:14px;opacity:0;pointer-events:none;transition:opacity .2s}
.toast.on{opacity:1}
footer{border-top:1px solid var(--line);color:var(--mut);font-size:12px;padding:20px 16px;text-align:center}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
